{
  "name": "saprili",
  "version": "0.1.0",
  "private": true,
  "description": "Saprili: your storybook scribe (Chrome extension).",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "postbuild": "node scripts/check-manifest-permissions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:headers": "node scripts/check-headers.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs",
    "e2e": "npm run build && node scripts/e2e-phase2.mjs && node scripts/e2e-phase3.mjs && node scripts/e2e-phase4.mjs",
    "package": "node scripts/pending.mjs package 12"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "idb": "^8.0.4",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
